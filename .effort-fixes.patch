@@ -0,0 +1,56 @@
+name: Effort compatibility
+
+on:
+  pull_request:
+    paths:
+      - src/obs_agent/**
+      - tests/test_effort*.py
+      - tests/test_claude_context_binary.py
+      - tests/test_tools.py
+      - tests/test_telegram.py
+      - .github/workflows/effort.yml
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  effort:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
+        with:
+          python-version: '3.13.5'
+      - name: Install locked dependencies
+        run: |
+          python -m pip install uv
+          uv sync --frozen --extra dev
+      - name: Run unit and transport regression suites
+        run: |
+          .venv/bin/python -m pytest -q --tb=short \
+            tests/test_effort.py tests/test_config.py tests/test_session.py \
+            tests/test_tools.py tests/test_telegram.py tests/test_telegram_state_store.py \
+            tests/test_cli.py tests/test_daemon.py --junitxml=effort-results.xml
+      - name: Verify installed CLI effort payloads without external networking
+        shell: bash
+        run: |
+          sudo unshare --net -- bash -c '
+            set -euo pipefail
+            ip link set lo up
+            cd "$2"
+            exec runuser -u "$1" -- env OBS_RUN_LOCAL_CLAUDE_CONTEXT_TESTS=1 \
+              "$2/.venv/bin/python" -m pytest -q --tb=short \
+              tests/test_effort_binary.py --junitxml="$2/effort-binary-results.xml"
+          ' _ "$(id -un)" "$GITHUB_WORKSPACE"
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        if: always()
+        with:
+          name: effort-test-results
+          path: |
+            effort-results.xml
+            effort-binary-results.xml
+          retention-days: 7
