# Recursive Harness Builder environment template
#
# Copy this file to `.env` and replace placeholders for your machine.
# Keep real `.env` files out of git. Values below are examples only.
# Profile-specific variables use OBS_<PROFILE>_... and are mapped to generic
# OBS_... names when OBS_PROFILE or --profile selects that profile.

# -----------------------------------------------------------------------------
# Profile and project directory
# -----------------------------------------------------------------------------

# Runtime profile. Common values: prod, test.
OBS_PROFILE=prod

# Current code name for the project directory where agents run Claude Code.
# For the first run, point this at the bundled starter project.
# It contains minimal entry instructions and flat v1 recursive-workflow procedures.
OBS_VAULT_PATH=/absolute/path/to/repo/examples/recursive-workflow

# Optional shorthand default for new root sessions: claude, opus, sonnet, haiku,
# gpt, gemini, or a full model ID.
OBS_DEFAULT_MODEL=claude

# Optional hard override for all root sessions. Leave blank unless you really
# want every root session to use one model.
# OBS_AGENT_MODEL=claude-opus-4-7
# OBS_MODEL=claude-opus-4-7

# -----------------------------------------------------------------------------
# Local daemon and runtime tuning
# -----------------------------------------------------------------------------

OBS_DAEMON_HOST=127.0.0.1
OBS_DAEMON_PORT=7832
OBS_CACHE_WINDOW=3600000
OBS_MAX_QUEUE_CONTINUATIONS=3
OBS_BG_FORK_TIMEOUT=600
OBS_MAX_BUFFER_SIZE=10485760
OBS_CONTEXT_WINDOW_ESTIMATE_TOKENS=1000000
OBS_CONTEXT_PROBE_CLAUDE_CLI=false

# Idle Claude Code process management. Tune for your machine.
# OBS_CLAUDE_IDLE_PROCESS_CAP=50
OBS_CLAUDE_KILL_ON_IDLE=false

# Optional W&B Weave tracing. Set to entity/project-name to enable.
# Requires: uv pip install -e ".[tracing]"
# WEAVE_PROJECT=my-entity/obs-agent

# Optional runtime logs.
# OBS_RUNTIME_LOG_FILE=/absolute/path/to/obs-runtime.log
# OBS_TELEGRAM_LOG_FILE=/absolute/path/to/telegram.log
OBS_TELEGRAM_LOG_POLLING=false

# -----------------------------------------------------------------------------
# Cache proxy and provider routing
# -----------------------------------------------------------------------------

OBS_CACHE_PROXY_ENABLED=true
OBS_CACHE_PROXY_PORT=18923
# OBS_SKIP_CACHE_PROXY=1

# Non-Claude models are routed through a local CLIProxyAPI-compatible server.
OBS_CLI_PROXY_BASE_URL=http://127.0.0.1:8317
OBS_CLI_PROXY_API_KEY=replace-with-local-cli-proxy-key

# Standalone cache proxy currently also reads these legacy bare names.
CLI_PROXY_BASE_URL=http://127.0.0.1:8317
CLI_PROXY_API_KEY=replace-with-local-cli-proxy-key
CACHE_PROXY_LOG_DIR=.obs-agent/cache-proxy-log
CACHE_PROXY_SAVE_BODIES=false

# Usually set by the runtime when the cache proxy is enabled. Only override for
# debugging or custom proxy setups.
# ANTHROPIC_API_KEY=replace-with-anthropic-api-key
# ANTHROPIC_BASE_URL=http://localhost:18923

# -----------------------------------------------------------------------------
# Telegram bot mode (minimal public setup)
# -----------------------------------------------------------------------------

# Create a bot with BotFather and put the token here.
OBS_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token

# Optional comma-separated sender pool of raw BotFather tokens. A single bot is
# valid; multiple bots help concurrent agent trees avoid per-bot send limits.
# The primary polling bot is OBS_TELEGRAM_BOT_TOKEN if set, otherwise the first
# token in this list.
# OBS_TELEGRAM_BOT_TOKENS=1234567890:replace-with-primary-token,2345678901:replace-with-second-token

# Required numeric Telegram user IDs allowed to control the bot.
OBS_TELEGRAM_ALLOWED_USERS=123456789

# Optional username used for visible notifications/mentions. Do not include @.
# OBS_TELEGRAM_NOTIFY_USERNAME=your_telegram_username

# Telegram persistence and temporary files. Keep state DB outside temp root.
OBS_TELEGRAM_TEMP_ROOT=.obs-agent/tmp
OBS_TELEGRAM_STATE_DB_PATH=.obs-agent/state/telegram-state.sqlite3
OBS_TELEGRAM_STATE_RETENTION_DAYS=30
OBS_TELEGRAM_DROP_PENDING_UPDATES=false

# -----------------------------------------------------------------------------
# Telegram userbot provisioning (optional advanced setup)
# -----------------------------------------------------------------------------

# Only needed if you want the harness to create/manage Telegram groups/folders
# using a user account. Bot-only operation does not require these.
# OBS_TELEGRAM_USERBOT_API_ID=123456
# OBS_TELEGRAM_USERBOT_API_HASH=replace-with-telegram-api-hash
# OBS_TELEGRAM_USERBOT_SESSION=replace-with-telethon-string-session
# OBS_TELEGRAM_GROUP_FOLDER_TITLE=Recursive Harness
# OBS_TELEGRAM_GROUP_ADDLIST_URL=https://t.me/addlist/replace-with-addlist-id

# -----------------------------------------------------------------------------
# Telegram transport behavior
# -----------------------------------------------------------------------------

OBS_TELEGRAM_TRANSPORT_BASE_CHAT_INTERVAL_SECONDS=0.35
OBS_TELEGRAM_TRANSPORT_MAX_CHAT_INTERVAL_SECONDS=5.0
OBS_TELEGRAM_TYPING_ACTION_INTERVAL_SECONDS=4.0
OBS_TELEGRAM_TYPING_ACTIONS_ENABLED=true

# -----------------------------------------------------------------------------
# Voice transcription (optional)
# -----------------------------------------------------------------------------

# The current runtime calls this executable as:
#   <script> <audio_file> <title> <destination_directory>
# and expects <destination_directory>/<title>.md to contain the transcript.
# Leave unset/commented unless you have a platform-specific script.
# OBS_TELEGRAM_TRANSCRIPTION_SCRIPT=/absolute/path/to/transcribe-script


# -----------------------------------------------------------------------------
# Production profile aliases
# -----------------------------------------------------------------------------

# These are useful when OBS_PROFILE=prod and you want production values to stay
# separate from generic OBS_TELEGRAM_* keys. Runtime profile mapping turns
# OBS_PROD_TELEGRAM_BOT_TOKEN into OBS_TELEGRAM_BOT_TOKEN when prod is active.
# OBS_PROD_TELEGRAM_BOT_TOKEN=replace-with-prod-bot-token
# OBS_PROD_TELEGRAM_ALLOWED_USERS=123456789
# OBS_PROD_TELEGRAM_USERBOT_API_ID=123456
# OBS_PROD_TELEGRAM_USERBOT_API_HASH=replace-with-prod-api-hash
# OBS_PROD_TELEGRAM_USERBOT_SESSION=replace-with-prod-telethon-string-session
# OBS_PROD_TELEGRAM_GROUP_FOLDER_TITLE=Recursive Harness
# OBS_PROD_TELEGRAM_GROUP_ADDLIST_URL=https://t.me/addlist/replace-with-prod-addlist-id

# -----------------------------------------------------------------------------
# Test profile example
# -----------------------------------------------------------------------------

# These populate generic OBS_TELEGRAM_* values when OBS_PROFILE=test or --test
# is active and the generic value is not already set.
# OBS_TEST_VAULT=/absolute/path/to/test-project-directory
OBS_TEST_VAULT_PATH=/absolute/path/to/test-project-directory
OBS_TEST_DAEMON_PORT=7833
OBS_TEST_TELEGRAM_BOT_TOKEN=replace-with-test-bot-token
OBS_TEST_TELEGRAM_BOT_TOKENS=replace-with-test-token-1,replace-with-test-token-2
OBS_TEST_TELEGRAM_ALLOWED_USERS=123456789
OBS_TEST_TELEGRAM_NOTIFY_USERNAME=test_notify_username

# Optional second test bot / names used by live Telegram test harnesses.
# OBS_TEST_TELEGRAM_BOT_TOKEN_2=replace-with-second-test-bot-token
# OBS_TEST_TELEGRAM_BOT_USERNAME=test_bot_username
# OBS_TEST_TELEGRAM_BOT_USERNAMES=test_bot_username,second_test_bot_username
# OBS_TEST_TELEGRAM_FORUM_CHAT_ID=-1001234567890

# Optional test userbot provisioning credentials.
# OBS_TEST_TELEGRAM_API_ID=123456
# OBS_TEST_TELEGRAM_API_HASH=replace-with-test-api-hash
# OBS_TEST_TELEGRAM_SESSION=replace-with-test-telethon-string-session
# OBS_TEST_TELEGRAM_USERBOT_API_ID=123456
# OBS_TEST_TELEGRAM_USERBOT_API_HASH=replace-with-test-api-hash
# OBS_TEST_TELEGRAM_USERBOT_SESSION=replace-with-test-telethon-string-session
# OBS_TEST_TELEGRAM_GROUP_FOLDER_TITLE=Recursive Harness Tests
# OBS_TEST_TELEGRAM_GROUP_ADDLIST_URL=https://t.me/addlist/replace-with-test-addlist-id
# OBS_TEST_TELEGRAM_ALLOW_BOT_CREATION=false
# OBS_TEST_TELEGRAM_ISOLATED_RESOURCES=true
# OBS_TEST_TELEGRAM_KILL_EXISTING_DAEMONS=false

# -----------------------------------------------------------------------------
# Legacy/profile aliases observed in tests
# -----------------------------------------------------------------------------

# Some older tests reference these names. Prefer OBS_TEST_* / generic OBS_* in
# new configuration unless a specific test asks for one of these.
# OBS_TELEGRAM_PROD_BOT_TOKEN=replace-with-prod-bot-token
# OBS_TELEGRAM_PROD_ALLOWED_USERS=123456789
# OBS_TELEGRAM_TEST_BOT_TOKEN=replace-with-test-bot-token
# OBS_TELEGRAM_TEST_BOT_TOKEN_2=replace-with-second-test-bot-token
# OBS_TELEGRAM_TEST_SECOND_BOT_TOKEN=replace-with-second-test-bot-token
# OBS_TELEGRAM_TEST_NOTIFY_USERNAME=test_notify_username
# OBS_TELEGRAM_LIVE_TEST_VAULT=/absolute/path/to/live-test-project-directory

# -----------------------------------------------------------------------------
# CLI and eval/development helpers
# -----------------------------------------------------------------------------

# Force simple stdin/stdout mode for scripted CLI smoke tests.
# OBS_SIMPLE_INPUT=1
# OBS_EVAL_PROMPT=> 

# Eval harness controls.
# OBS_EVAL=true
# OBS_EVAL_ENABLE_CLI=1
# OBS_EVAL_PROFILE=smoke
# OBS_EVAL_LANE=deterministic
# OBS_EVAL_JUDGE_MODEL=claude-sonnet-4-6
# OBS_EVAL_TEMPLATE_VAULT=/absolute/path/to/template-project-directory
# OBS_EVAL_REQUIRE_CLEAN_TEMPLATE=1
# OBS_REAL_VAULT_PATH=/absolute/path/to/real-project-directory
# OBS_TG_SCENARIOS=basic,fork
# OBS_TG_INTER_SCENARIO_DRAIN_SECONDS=3
# OBS_LIVE_PARALLEL_WORKER_INDEX=0

# Miscellaneous test-only variables seen in the test suite.
# OBS_TEST_MARKER=example-marker
# OBS_KITCHEN_TAG=example-tag


# Notes:
# - ANTHROPIC_UPSTREAM and CLI_PROXY_UPSTREAM are internal cache-proxy constants,
#   not supported public configuration keys. Use ANTHROPIC_BASE_URL,
#   CLI_PROXY_BASE_URL, and OBS_CLI_PROXY_BASE_URL instead.
